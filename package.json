{
  "name": "weekly-report-system",
  "version": "2.1.0",
  "private": false,
  "description": "自托管的团队学习周报系统：Markdown 周报 + 讨论 + 排行榜 + 通知，零前端框架",
  "main": "server.js",
  "scripts": {
