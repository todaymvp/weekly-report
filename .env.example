# ====== 系统与数据库 ======
IMAGE_TAG=latest
APP_PORT=3000
DATA_PATH=/data/study

# ====== 管理员初始配置 ======
ADMIN_USERNAME=admin
ADMIN_PASSWORD=please-change-me
ADMIN_EMAIL=admin@example.com
SEED_DEMO=false

# ====== 安全配置 ======
COOKIE_SECURE=true
TRUST_PROXY=true
DEV_CODE_HINT=false

# ====== 邮件配置 (Resend) ======
MAIL_MODE=smtp
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=resend
SMTP_PASS=re_xxx  # 这里填你完整的 Resend API Key
MAIL_FROM="HJSec学习周报 <noreply@hjsec.top>"
# 站点对外地址，用于邮件里的「查看并回复」链接
SITE_URL=https://study.hjsec.top

# ====== 日志 ======
# debug 会连静态资源请求一起打；info 只打 /api 与审计事件
LOG_LEVEL=info
